<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- КОГО МЫ ИМЕЕМ ПРАВО СПРОСИТЬ (#422).

         С Android 11 приложение не видит чужие пакеты без объявления. Нам нужно ровно
         одно: узнать, установлено ли на телефоне приложение, которое умеет тот же прибор.
         Это не слежка за установленным — список закрытый и назван поимённо, и нужен он,
         чтобы вместо «прибор занят кем-то» сказать «вероятно, им». -->
    <queries>
        <package android:name="tk.glucodata" />
        <package android:name="tk.glucodata.ng" />
        <package android:name="com.eveningoutpost.dexdrip" />
        <package android:name="info.nightscout.androidaps" />
        <package android:name="com.sibionics.cgm" />
    </queries>

    <!-- ЧЕМ БУДИМ НОЧЬЮ (#468).

         Канал тревог заведён как будильник: громкость будильника, обход «Не беспокоить»,
         полноэкранное намерение, вибрация. Всё это система исполняет ТОЛЬКО при заявленных
         разрешениях, а без них молча делает вид, что исполнила:

         ACCESS_NOTIFICATION_POLICY — без него setBypassDnd(true) игнорируется, и ночью, когда
         телефон в «Не беспокоить», тревога приходит беззвучной. Промах приходится ровно на тот
         случай, ради которого канал и заведён. Разрешение мало объявить — доступ выдаёт человек
         в системных настройках, поэтому мы ещё и спрашиваем (см. Тревоги.проверитьГотовность).

         USE_FULL_SCREEN_INTENT — с Android 14 без него полноэкранная тревога вырождается в
         строку в шторке, которую утром смахнут вместе с почтой.

         VIBRATE — для спящего человека вибрация второй канал после звука, а если телефон под
         подушкой, то и первый. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Диплинк (SugarLife#315). До этого схема не была зарегистрирована нигде:
                 строка custom_url_scheme в strings.xml лежала мёртвой, и ссылка вида
                 sugarlife://… не открывала ничего.

                 Схему берём из flavor'а (@string/deep_link_scheme): у Pro она своя, иначе
                 одна ссылка открывала бы то одно приложение, то другое — а они управляют
                 подачей инсулина по-разному (#296).

                 BROWSABLE обязателен: без него ссылка из браузера не сработает, а ровно
                 оттуда мы и ведём. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/deep_link_scheme" />
            </intent-filter>
        </activity>

        <!-- Foreground-сервис: держит процесс живым в фоне (иначе HyperOS убивает → потеря сенсора).

             ТИП ОБЪЯВЛЕН ДВОЙНОЙ, А ВЫБИРАЕТСЯ В МОМЕНТ ЗАПУСКА (#380). Здесь перечислено то, чем
             сервис ИМЕЕТ ПРАВО быть; чем он будет на самом деле — решает SugarLifeService.start.

             connectedDevice — наш случай по существу: постоянный обмен с прибором по Bluetooth.
             Ограничения по времени у него нет, и ровно его объявляют xDrip+ и Juggluco — оба
             читают сенсоры круглосуточно годами.

             dataSync остаётся запасным: предусловие connectedDevice — ВЫДАННОЕ разрешение на
             Bluetooth, а человек на одном облаке (Nightscout, без единого BLE-прибора) его не
             давал. Без запасного варианта мы починили бы одному и сломали другому.

             Почему нельзя просто оставить dataSync: на Android 15 у него предел 6 часов в сутки
             на всё приложение. Посмотрел на экран вечером, лёг спать — под утро мониторинг
             выключен. Ровно в те часы, когда он нужнее всего. -->
        <service
            android:name=".SugarLifeService"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <!-- После перезагрузки мониторинг сам не включался (#380): человек узнавал об этом по дырке
             в графике. У xDrip+ и Juggluco приёмник загрузки есть, у нас не было.

             QUICKBOOT_POWERON — «быстрая загрузка» вендорских прошивок (HTC/Xiaomi): при ней
             BOOT_COMPLETED не приходит вовсе. Строка взята у Juggluco, там она с той же целью. -->
        <!-- НОЧНАЯ ПЕРЕЗАГРУЗКА (#476). BOOT_COMPLETED на телефоне с шифрованием приходит только
             ПОСЛЕ первой разблокировки. Обновление системы ставится ночью, телефон перезагружается,
             человек спит и не разблокирует — значит до утра не поднимется ни мониторинг, ни тревоги,
             и узнает он об этом по дырке в графике, а не вовремя.

             directBootAware + LOCKED_BOOT_COMPLETED дают приёмнику право проснуться до разблокировки.
             Движок там поднять нельзя (его база зашифрована до ввода кода), но СКАЗАТЬ можно — и это
             ровно уровень «обещание нарушено»: защиты нет, и человек должен об этом узнать. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Виджет на рабочем столе (#449). exported=true обязателен: намерения ему шлёт
             система (лаунчер), а не мы. -->
        <receiver
            android:name=".SugarWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Собственное пробуждение виджета в момент, когда показание протухло (#530):
                     сам себя чаще раза в полчаса он обновлять не вправе, а погаснуть должен вовремя. -->
                <action android:name="ru.imiron.sugarlife.ВИДЖЕТ_УСТАРЕЛ" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sugar_widget_info" />
        </receiver>

        <!-- «Понял» по тревоге (#482). exported=false: намерение приходит от нашего же уведомления.
             Приёмник нужен именно отдельный — нажатие случается, когда процесса может не быть, и
             система поднимает его ради этого приёмника, чтобы ответ человека не пропал. -->
        <receiver
            android:name=".ПонялПриёмник"
            android:enabled="true"
            android:exported="false" />

<provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Установка обновления из приложения (#269). Тихой установки это НЕ даёт: система
         всё равно спросит подтверждение. Даёт одно нажатие вместо четырёх шагов через
         браузер и «Загрузки». -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Foreground-сервис фонового мониторинга + его уведомление (Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Тип connectedDevice — основной для нас (#380): обмен с прибором по Bluetooth, без предела
         в 6 часов, который есть у dataSync на Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Звуковая опора (SugarLifeCore#123): держимся воспроизведением на прошивках, которые выгружают
         приложения по своему усмотрению. Выключено по умолчанию; на стоковом Android не нужно. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Обмен с прибором нельзя прерывать посреди (#380): побудка помпы длится 12 секунд, за ней
         шестнадцать кадров страницы истории. Foreground-сервис держит ПРОЦЕСС, но не мешает
         процессору уснуть между событиями. AndroidAPS держит PARTIAL_WAKE_LOCK вокруг всей очереди
         команд, xDrip — вокруг каждого сеанса. Прерывание посередине человек читает как «связь плохая». -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Автозапуск после перезагрузки и после обновления самого приложения (#380). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Точный будильник (#482). Объявляем, но НЕ включаем сам: пробуждение по нему даёт заданное
         время вместо «в пределах девяти минут», ценой отдельного разрешения и системного
         предупреждения про батарею. Цена обеих сторон названа человеку числами, выбирает он —
         выключателем `alarms.exactWakeups`. На Android 12 система выдаёт это разрешение при
         установке сама, и именно поэтому одного разрешения нам мало: согласия в нём нет. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Просьба об исключении из оптимизации батареи. Просим ЯВНО и с объяснением — молча такое
         не берут. Заявлено у xDrip+ и Juggluco с той же целью. -->
    <uses-permission-sdk-23 android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- BLE: сканирование (без геолокации) + подключение к сенсору/помпе. Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <!-- Те же две возможности до Android 12 — другими разрешениями (#299).

         Без них приложение на Android 8–11 ставилось и работало, но скан не находил
         НИЧЕГО и никогда: обращение к BluetoothAdapter падало на SecurityException, а
         запрос геолокации (плагин просит её правильно, по версии) система отклоняла
         молча — просить незаявленное в манифесте бесполезно, диалога не будет вовсе.
         Человек при этом видел рабочее приложение и искал поломку в сенсоре.

         ACCESS_FINE_LOCATION нужна не для геолокации: до Android 12 система считала
         список устройств рядом способом узнать положение, и без этой отметки скан
         возвращал пустой список без ошибки.

         maxSdkVersion=30 обязателен. Без него на Android 12+ появился бы запрос
         геолокации, которого сейчас нет и который там не нужен, — ровно от него мы
         закрылись флагом neverForLocation выше. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Ни одна из этих железок не обязательна (#299).

         Разрешения выше сами по себе порождают требования: из BLUETOOTH/BLUETOOTH_ADMIN
         выводится android.hardware.bluetooth, из ACCESS_FINE_LOCATION — hardware.location,
         и по умолчанию выведенное считается ОБЯЗАТЕЛЬНЫМ. Магазин по такому требованию
         прячет приложение от устройств без этой железки. То есть починка Android 8–11
         молча отрезала бы часть устройств — ровно наоборот тому, зачем делалась.

         И это не формальность: приложение полностью работает без Bluetooth вообще, когда
         данные идут через облако. Требовать железо, без которого оно живёт, нельзя. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Камера — только для кода сенсора с коробки (#350). Плагин сканера своего манифеста
         не приносит, разрешение объявляем мы.

         required="false" обязательно: без него Google Play спрячет приложение от планшетов
         без камеры, а работать оно там будет полностью — код вводится и руками. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
