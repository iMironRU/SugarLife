<?xml version="1.0" encoding="utf-8"?>
<!--
    Виджет сахара — по макету v2 (SugarLife#449, #511).

    ЧТО ИЗМЕНИЛОСЬ. Было: кольцо-шкала слева, число, возраст, подстрочник. Стало то же, что на живом
    баннере айфона, — пять величин: показание со стрелкой, возраст, сколько до следующего, тренд за три
    часа и активный инсулин. Одна и та же поверхность на двух платформах должна отвечать одинаково;
    кольцо отвечало только на «где я по шкале», а «как я сюда пришёл» — не отвечало вовсе.

    ГРАФИК КАРТИНКОЙ. Лаунчер разворачивает чужой процесс и знает узкий список вьюх: ни дуг, ни путей
    там нет. Поэтому линия рисуется на холсте и отдаётся готовым изображением, а числа остаются
    настоящим текстом — иначе они не подчинялись бы системному размеру шрифта.

    ВОЗРАСТ И СЕКУНДОМЕР СЧИТАЕТ ЛАУНЧЕР. Два Chronometer идут сами, внутри его процесса, и продолжают
    идти, когда наша служба остановлена. Виджет с застывшим «2 мин» врал бы убедительнее пустого.

    РАСКЛАДКА ПЕРЕЖИВАЕТ ОБА РАЗМЕРА. RemoteViews не умеет constraint-раскладок, поэтому колонка с
    весами: в узком виджете (2×1) график и нижняя строка прячутся кодом, остаётся число со стрелкой.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sugar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/sugar_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sugar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E9E9ED"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:text="—" />

        <!-- Возраст у правого края: «верить ли числу» — второй вопрос после самого числа. -->
        <Chronometer
            android:id="@+id/sugar_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#8B90A3"
            android:textSize="13sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sugar_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_ring_desc" />

    <LinearLayout
        android:id="@+id/sugar_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Сколько до следующего показания: «ждать или уже беспокоиться». -->
        <Chronometer
            android:id="@+id/sugar_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B90A3"
            android:textSize="12sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/sugar_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#A8B6D9"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
