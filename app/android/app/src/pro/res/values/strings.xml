<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- У Pro своя схема: ссылка sugarlife:// обязана открывать Lite, даже когда на
         телефоне стоят оба издания. Управление подачей — не то, куда попадают случайно. -->
    <string name="deep_link_scheme">sugarlife.pro</string>
    <!-- ИМЯ ИЗДАНИЯ (#392). Разошлись мы везде — идентификатор, иконка, схема ссылки, — а имя забыли,
         и на телефоне владельца оба приложения подписаны «SugarLife.Lite». Эти два издания по-разному
         относятся к подаче инсулина: открыть не то — не косметическая ошибка. -->
    <string name="app_name">SugarLife.Pro</string>
    <!-- И ПОДПИСЬ ПОД ЗНАЧКОМ ТОЖЕ. Первая правка #392 заменила только app_name — а лаунчер
         показывает метку АКТИВНОСТИ, если она задана, и она задана: android:label активности
         указывает на title_activity_main. То есть значок Pro на телефоне по-прежнему был
         подписан «SugarLife.Lite», ровно как в жалобе, ради которой всё делалось. -->
    <string name="title_activity_main">SugarLife.Pro</string>
</resources>
