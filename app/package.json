{
  "name": "app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "CAP=1 npm run build && cap sync",
    "cap:ios": "CAP=1 npm run build && cap sync ios && cap open ios",
    "cap:android": "CAP=1 npm run build && cap sync android && cap open android",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "build:pro": "SUGARLIFE_EDITION=pro npm run build",
    "edition:check": "node scripts/edition-check.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capgo/capacitor-updater": "^8.51.3",
    "echarts": "^6.1.0",
    "idb": "^8.0.3",
    "ionicons": "^8.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
