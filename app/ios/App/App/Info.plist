<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Фоновая работа с Bluetooth (#379). Без этого ключа iOS приостанавливает приложение через
	     считанные секунды после ухода с экрана: CoreBluetooth перестаёт звать наши колбэки, и
	     мониторинг замирает до следующего открытия. Сенсор при этом рядом и вещает каждую минуту.
	     Тот же режим объявляют Loop, xDrip4iOS и все, кто работает с прибором постоянно. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<!-- Для облачного режима (#388): у человека на одном облаке прибора нет, и будить приложение
		     нечем. Миллисекунда тишины раз в несколько секунд не даёт системе его приостановить.
		     Включается ТОЛЬКО по выбору человека и ТОЛЬКО в фоне; по умолчанию выключено. -->
		<string>audio</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Подключение к сенсору глюкозы и помпе по Bluetooth</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Подключение к сенсору глюкозы и помпе по Bluetooth</string>
	<!-- Диплинк (SugarLife#315). Универсальные ссылки (https без окна выбора) требуют
	     Associated Domains, а это платный аккаунт разработчика — поэтому схема.
	     Издание Pro переопределяет её своим Info.plist. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ru.imiron.sugarlife</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sugarlife</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Чтобы прочитать код сенсора с коробки — вводить восемь символов руками легко с ошибкой</string>
</dict>
</plist>
