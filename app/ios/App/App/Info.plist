<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ПРЕФИКС КОМАНДЫ — ЧТОБЫ СОБРАТЬ ИМЯ ГРУППЫ СВЯЗКИ (SugarLife#542).

	     Общая полка приложения и виджета называется «<префикс команды>.ru.imiron.sugarlife.общее»,
	     и префикс известен только в момент подписи. Зашить его строкой нельзя — у другого
	     разработчика сборка молча перестала бы делиться данными сама с собой; спросить систему в
	     работе тоже нельзя. Единственный путь — подставить сюда, где сборщик его знает.

	     Без этого ключа имя собиралось без префикса, связка отвергала и запись, и чтение, и виджет
	     честно показывал «нет данных» при работающем приложении. -->
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- Имя общего контейнера, через который петля читает наши показания (SugarLife#413).
	     Читаем его тем же способом, каким iAPS читает своё, — из Info.plist. -->
	<key>AppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- ЯЗЫК ПРИЛОЖЕНИЯ — РУССКИЙ, И ЭТО НЕ ФОРМАЛЬНОСТЬ (#534).

	     Весь наш интерфейс живёт в вебе и всегда был по-русски, но системные части — меню
	     «Скопировать / Вставить» над текстом, кнопки системных запросов, «Отменить» в диалогах —
	     рисует UIKit. Язык для них он выбирает не по телефону, а по тому, какие языки объявило
	     САМО приложение: у нас числился один английский, поэтому над русским текстом всплывало
	     «Copy · Paste · Look Up».

	     Отдельной папки с переводами у нас нет и не нужно (переводить нечего — строки в вебе),
	     поэтому язык объявляем прямо здесь: так Apple и предлагает поступать приложениям, чей
	     текст лежит вне .lproj. Английский оставляем вторым — телефону с английским языком
	     системные кнопки честнее показать по-английски. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Живой баннер на экране блокировки и в «Динамическом острове» (#428). Без этого
	     ключа ActivityKit просто не запустит активность, и молча. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Частые обновления: сахар меняется каждые пять минут, и система иначе начинает
	     придерживать наши правки баннера. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Фоновая работа с Bluetooth (#379). Без этого ключа iOS приостанавливает приложение через
	     считанные секунды после ухода с экрана: CoreBluetooth перестаёт звать наши колбэки, и
	     мониторинг замирает до следующего открытия. Сенсор при этом рядом и вещает каждую минуту.
	     Тот же режим объявляют Loop, xDrip4iOS и все, кто работает с прибором постоянно. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<!-- Для облачного режима (#388): у человека на одном облаке прибора нет, и будить приложение
		     нечем. Миллисекунда тишины раз в несколько секунд не даёт системе его приостановить.
		     Включается ТОЛЬКО по выбору человека и ТОЛЬКО в фоне; по умолчанию выключено. -->
		<string>audio</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Подключение к сенсору глюкозы и помпе по Bluetooth</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Подключение к сенсору глюкозы и помпе по Bluetooth</string>
	<!-- Диплинк (SugarLife#315). Универсальные ссылки (https без окна выбора) требуют
	     Associated Domains, а это платный аккаунт разработчика — поэтому схема.
	     Издание Pro переопределяет её своим Info.plist. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ru.imiron.sugarlife</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sugarlife</string>
			</array>
		</dict>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Чтобы не спрашивать вес и давление заново — их уже записали ваши весы, тонометр или часы. Мы читаем только эти два показателя.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Чтобы ваши сахара, инсулин и углеводы были в «Здоровье» вместе с остальным — и их видели приложения, которыми вы уже пользуетесь. Запись выключена по умолчанию и включается вами.</string>
	<key>NSCameraUsageDescription</key>
	<string>Чтобы прочитать код сенсора с коробки — вводить восемь символов руками легко с ошибкой</string>
</dict>
</plist>
