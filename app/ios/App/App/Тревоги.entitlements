<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- СРОЧНЫЕ УВЕДОМЛЕНИЯ — ПРАВО, БЕЗ КОТОРОГО НАШ УРОВЕНЬ НЕ ДЕЙСТВУЕТ (SugarLife#500).

	     Тревоги мы помечаем interruptionLevel = .timeSensitive: срочное поднимается над обычными и
	     проходит сквозь «Не беспокоить», если срочные разрешены приложению. Но уровень — просьба,
	     а право на неё — вот это. Пока сборка подписывалась вовсе без прав (#466 убрал файл прав
	     целиком, спасая подпись от платной группы), система МОЛЧА понижала срочное до обычного:
	     сирена звучала (наш звук — не уведомление), а карточки на экране не было.

	     Этот файл — умолчание для всех сборок: право бесплатное, личная команда его выдаёт.
	     Платная группа (App.entitlements) остаётся отдельной и по просьбе. -->
	<!-- Общая полка с виджетом (#542): какой бы файл прав ни выбрали, виджет должен видеть данные. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ru.imiron.sugarlife.общее</string>
	</array>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
