<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ОБЩАЯ ПОЛКА ДЛЯ ПРИЛОЖЕНИЯ И ВИДЖЕТА (SugarLife#542).

	     Виджет на рабочем столе — отдельный процесс: он рисует то, что ему положили, и взять данные
	     ему больше неоткуда. Обычный путь — общий контейнер (App.entitlements), но это платная
	     возможность, и личной команде Apple её не выдаёт.

	     Связка ключей выдаётся: в профиле личной команды стоит `keychain-access-groups: <команда>.*`.
	     Поэтому умолчание сборки — этот файл: без него виджет ставится, но всегда пуст.

	     Здесь только группа связки и ничего больше: право на срочные уведомления личной команде не
	     выдают (см. debug.xcconfig), а общий контейнер стоит денег. Оба остаются в своих файлах и
	     подключаются по просьбе — тогда группу связки надо добавить и туда, иначе виджет ослепнет. -->
	<!-- ЧТЕНИЕ «ЗДОРОВЬЯ» (#557). Право бесплатной команде выдаётся — проверено сборкой на
	     устройство 25 августа 2026: профиль личной команды пришёл с этим ключом. В отличие от
	     срочных уведомлений и общей группы приложений, которые той же команде не дают.

	     `healthkit.access` остаётся ПУСТЫМ и при записи (#583). Этот ключ — про доступ к клиническим
	     записям (выписки, анализы из медучреждений), а не про обычные образцы: сахар, инсулин и
	     углеводы пишутся по одному лишь `healthkit` плюс описания в Info.plist. Просить сюда лишнее
	     значило бы объяснять человеку доступ, которым мы не пользуемся. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ru.imiron.sugarlife.общее</string>
	</array>
</dict>
</plist>
