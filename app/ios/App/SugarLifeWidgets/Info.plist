<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ПРЕФИКС КОМАНДЫ — ЧТОБЫ СОБРАТЬ ИМЯ ГРУППЫ СВЯЗКИ (SugarLife#542).

	     Общая полка приложения и виджета называется «<префикс команды>.ru.imiron.sugarlife.общее»,
	     и префикс известен только в момент подписи. Зашить его строкой нельзя — у другого
	     разработчика сборка молча перестала бы делиться данными сама с собой; спросить систему в
	     работе тоже нельзя. Единственный путь — подставить сюда, где сборщик его знает.

	     Без этого ключа имя собиралось без префикса, связка отвергала и запись, и чтение, и виджет
	     честно показывал «нет данных» при работающем приложении. -->
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- БЕЗ ЭТОГО КЛЮЧА НЕ СТАВИТСЯ ВСЁ ПРИЛОЖЕНИЕ (SugarLife#500). Расширение собиралось,
	     подписывалось и выглядело целым, но installd отвергал бандл целиком:
	     «missing or invalid CFBundleExecutable». Ни симулятор, ни телефон не принимали сборку,
	     и по сообщению казалось, что виноват виджет, а не одна отсутствующая строка. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>SugarLife</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
