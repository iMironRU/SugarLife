CAPACITOR_DEBUG = true

OTHER_LDFLAGS = $(inherited) -lsqlite3

// ОБЩИЙ КОНТЕЙНЕР С ПЕТЛЁЙ (SugarLife#413).
//
// Имя то же, что вычисляет себе iAPS (`Config.xcconfig`: group.com.$(DEVELOPMENT_TEAM).loopkit.LoopGroup),
// поэтому обе программы, собранные одной командой разработчика, оказываются в одной группе. Значение
// подставляется и в подпись (App.entitlements), и в Info.plist — в одном месте, чтобы они не разъехались.
APP_GROUP_ID = group.com.$(DEVELOPMENT_TEAM).loopkit.LoopGroup

// ПРАВА ПОДКЛЮЧАЮТСЯ ПО ПРОСЬБЕ, А НЕ ВСЕГДА.
//
// Общая группа приложений — платная возможность: личная команда разработчика (бесплатный Apple ID)
// её не поддерживает, и сборка на телефон падает при подписи. Пока файл прав стоял здесь безусловно,
// это ломало ЛЮБУЮ установку по кабелю — включая ту, где отдача в петлю никому не нужна.
//
// Поэтому по умолчанию прав нет, и приложение ставится у всех. Кому нужна отдача в iAPS, собирает так:
//
//   SL_ENTITLEMENTS=App/App.entitlements bash scripts/ios-на-телефон.sh
//
// Без прав отдача честно скажет, что контейнер недоступен (LoopFeed.доступность), — а не промолчит.
// Умолчание — права тревог (срочные уведомления): они бесплатные и нужны каждому, у кого
// приложение вообще следит за сахаром. Платная группа остаётся по просьбе, как и была.
SL_ENTITLEMENTS = App/Тревоги.entitlements
CODE_SIGN_ENTITLEMENTS = $(SL_ENTITLEMENTS)
